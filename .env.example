# ==============================================================================
# DALI Miel Orgánica - Environment Variables Template (.env.example)
# ==============================================================================
# IMPORTANT:
# - Variables prefixed with VITE_ are public and exposed to the client bundle.
# - NEVER put secret API keys in VITE_ variables.
# - Keep OPENROUTER_API_KEY, SUPABASE_SERVICE_ROLE_KEY and payment secrets private.
# ==============================================================================

# Supabase Public Configuration (Client & SSR)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Server-Side Secret (Server-Only, Never VITE_)
SUPABASE_SERVICE_ROLE_KEY=""

# Application Public URL (Server-Only, used for OpenRouter HTTP-Referer header)
# If not set, defaults to https://dali-miel-organica.lovable.app
APP_PUBLIC_URL=""

# OpenRouter Configuration (Server-Only, Never VITE_)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Chat & LLM Settings
CHAT_PRIMARY_LLM="google/gemma-3-4b-it:free"
CHAT_FALLBACK_LLM="openrouter/free"
CHAT_ENHANCEMENT_LLM=""
CHAT_JUDGE_LLM=""

# Chat Feature Flags
CHAT_USE_FALLBACK="true"
CHAT_USE_ENHANCEMENT="false"
CHAT_USE_JUDGE="false"

# Chat Sampling & Limits
CHAT_TEMPERATURE="0.2"
CHAT_TOP_P="0.8"
CHAT_MAX_TOKENS="450"
CHAT_TIMEOUT_MS="45000"

# RAG Configuration
RAG_MIN_SCORE="0.0"

# Development Asset Proxy (Local Vite dev only)
LOVABLE_PREVIEW_HOST="dali-miel-organica.lovable.app"


# ==============================================================================
# Stripe - Server Only
# ==============================================================================

# Stripe secret API key.
# TEST: sk_test_...
# LIVE: sk_live_...
# NEVER prefix this with VITE_
STRIPE_SECRET_KEY=""

# Stripe webhook signing secret.
# Usually starts with whsec_
# NEVER prefix this with VITE_
STRIPE_WEBHOOK_SECRET=""

# Public URL used by Stripe for success/cancel redirects.
# Local development:
# APP_PUBLIC_URL="http://localhost:5008"
#
# Production:
# APP_PUBLIC_URL="https://dali-miel-organica.onrender.com"
APP_PUBLIC_URL=""