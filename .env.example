# Stripe - Temporary Legacy Fallback
# ------------------------------------------------------------------------------

# Keep these only while Wompi Sandbox is being validated.
# Remove after Wompi migration is completed.

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""